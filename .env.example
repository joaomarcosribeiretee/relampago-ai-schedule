# Copie este arquivo para .env.local e preencha.
# Nunca commite o .env.local.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Dá para trocar o modelo sem mexer no código.
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Vozes: coral, nova, marin, sage, ash, ballad, shimmer
OPENAI_TTS_VOICE=coral
# 1 é o ritmo padrão. Acima disso fica mais rápido.
OPENAI_TTS_SPEED=1.25

# Google Cloud — cliente OAuth do tipo "Aplicativo da Web"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Fuso usado para interpretar "amanhã", "às 7" e horários livres.
RELAMPAGO_TIMEZONE=America/Sao_Paulo
